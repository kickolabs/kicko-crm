{
  "name": "@kicko/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./visa-catalog": "./src/visa-catalog.ts",
    "./provision": "./src/provision.ts",
    "./library": "./src/library.ts"
  },
  "scripts": {
    "start": "node scripts/dev-db.mjs",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "seed:demo": "dotenv -e ../../.env -- tsx prisma/seed-demo.ts",
    "test": "dotenv -e ../../.env -- vitest run",
    "typecheck": "tsc --noEmit",
    "admin:grant": "dotenv -e ../../.env -- tsx scripts/grant-admin.ts",
    "clean:test": "dotenv -e ../../.env -- tsx scripts/clean-test-data.ts",
    "library:import": "dotenv -e ../../.env -- tsx scripts/import-library.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@kicko/packs": "*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv-cli": "^8.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.16.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
