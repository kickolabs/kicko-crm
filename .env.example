# --- Database ---------------------------------------------------------------
# App connects as a NON-owner role so Postgres row-level security applies.
DATABASE_URL="postgresql://kicko_app:kicko_app@localhost:5433/kicko"
# Migrations run as the owner role.
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/kicko"

# --- Auth -------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-32+-random-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encrypts per-agency secrets (payment gateway keys). 32+ random chars.
ENCRYPTION_KEY="replace-with-32+-random-chars"

# --- File storage -----------------------------------------------------------
# local: files in ./.storage (dev). s3: Cloudflare R2 / S3 in production.
STORAGE_DRIVER="local"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="kicko-documents"
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Email (client portal links & message notifications) -------------------
# Without these, staff share portal links by copy/WhatsApp; nothing breaks.
# RESEND_API_KEY=
# EMAIL_FROM="Horizon Overseas <portal@yourdomain.com>"
# Show self-service portal links on screen (local dev / E2E only, never production):
# PORTAL_DEV_LINKS=1

# --- Scheduled jobs ---------------------------------------------------------
# Vercel Cron calls /api/cron/daily with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET="replace-with-random"

# --- WhatsApp ----------------------------------------------------------------
# Per-agency credentials live (encrypted) in Settings → WhatsApp. Optional override:
# META_GRAPH_VERSION="v23.0"

# --- Calling ---------------------------------------------------------------
# Telephony (Exotel / Twilio) is connected per agency in Settings → Calling.

# --- AI (platform-owned, metered per agency) --------------------------------
# Without these, AI features run in sandbox: call notes come from keyword rules,
# and only sandbox (scripted) calls are transcribed. Nothing breaks.
# ANTHROPIC_API_KEY=
# AI_MODEL="claude-sonnet-5-5"        # call notes, assistant
# AI_FAST_MODEL="claude-haiku-5-5"    # classification, extraction
# DEEPGRAM_API_KEY=                   # call recording transcription
# DEEPGRAM_MODEL="nova-3"
# DEEPGRAM_LANGUAGE="multi"           # English + Hindi code-switching

# --- Super-admin console (/admin) ------------------------------------------
# Kicko staff emails, comma-separated. Create each account (no workspace needed;
# asks for a password) with:
#   npm run admin:grant -- you@kicko.in
# Anyone else gets a 404 at /admin.
SUPER_ADMIN_EMAILS="admin@kicko.in"

# --- Kicko's own billing (agencies paying Kicko) -----------------------------
# Without these, subscriptions run in sandbox (checkout simulates payment).
# Kicko's legal details, printed on Kicko's GST invoices:
# KICKO_LEGAL_NAME="Kicko Technologies Private Limited"
# KICKO_ADDRESS="…"
# KICKO_GSTIN="33XXXXXXXXXXXXX"        # first two digits = state (33 = Tamil Nadu)
# KICKO_SAC="998314"                   # confirm the SAC code with your CA
# Shown on the legal pages (/terms, /privacy, /dpa, /security):
# KICKO_SUPPORT_EMAIL="support@kicko.in"
# KICKO_PRIVACY_EMAIL="privacy@kicko.in"
# KICKO_GRIEVANCE_OFFICER="Name of the Grievance Officer"   # required under India's IT Rules / DPDP Act
# KICKO_JURISDICTION_CITY="Chennai"    # courts named in the Terms
# Kicko's own Razorpay account (separate from any agency's):
# RAZORPAY_PLATFORM_KEY_ID=
# RAZORPAY_PLATFORM_KEY_SECRET=
# RAZORPAY_PLATFORM_WEBHOOK_SECRET=    # webhook URL: https://<app>/api/webhooks/platform/razorpay
# One Razorpay plan per plan × interval, priced per user INCLUDING GST:
# RAZORPAY_PLAN_STARTER_MONTH= RAZORPAY_PLAN_STARTER_YEAR=
# RAZORPAY_PLAN_GROWTH_MONTH=  RAZORPAY_PLAN_GROWTH_YEAR=
# RAZORPAY_PLAN_PRO_MONTH=     RAZORPAY_PLAN_PRO_YEAR=

# --- Later phases -----------------------------------------------------------
# STRIPE_SECRET_KEY= STRIPE_WEBHOOK_SECRET=
