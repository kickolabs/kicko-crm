{
  "name": "@kicko/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3000",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "e2e:serve": "dotenv -e ../../.env -v NEXT_DIST_DIR=.next-e2e -v NEXT_PUBLIC_APP_URL=http://localhost:3100 -v BETTER_AUTH_URL=http://localhost:3100 -v PORTAL_DEV_LINKS=1 -- next build && dotenv -e ../../.env -v NEXT_DIST_DIR=.next-e2e -v NEXT_PUBLIC_APP_URL=http://localhost:3100 -v BETTER_AUTH_URL=http://localhost:3100 -v PORTAL_DEV_LINKS=1 -- next start -p 3100"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@dnd-kit/core": "6.3.1",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@kicko/db": "*",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-auth": "1.7.12",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "1.60.0",
    "next": "15.5.28",
    "papaparse": "5.7.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "15.5.28",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv-cli": "^8.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
